# Configuration of the .env.local, Vercel's Environment Variables, and in `public\js\site-config.js`.

# By Vercel CLI
VERCEL_OIDC_TOKEN=""

# Server-only Vercel environment variables for /api/ai-agent/chat.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key (Supabase > Project Settings > API Keys). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
# Random string used to hash device/IP identifiers for quota tracking
AI_AGENT_RATE_LIMIT_SECRET=your_long_random_string
AI_AGENT_GOOGLE_KEYS=
AI_AGENT_DEEPSEEK_KEYS=
AI_AGENT_CLAUDE_KEYS=

# Optional AI configuration.
AI_AGENT_PROVIDER=google
AI_AGENT_MODEL=
AI_AGENT_SYSTEM_PROMPT=
AI_AGENT_RATE_LIMIT_SECRET=
ALLOWED_ORIGIN=https://belal-amr.vercel.app,http://localhost:8080,http://localhost:3000,http://localhost:3001
